ARG BASE_IMAGE
FROM mcr.microsoft.com/dotnet/sdk:9.0-bookworm-slim AS backend
WORKDIR /source
COPY common/Unity.DaemonTests.Backend/ ./
RUN dotnet publish --runtime linux-x64 --self-contained false --disable-build-servers --output /backend && \
    dotnet nuget locals all --clear

FROM ${BASE_IMAGE}
COPY --from=backend /backend/unity /usr/local/bin/composer
RUN chmod 755 /usr/local/bin/composer
ENV UNITY_CALL_TIMEOUT=300
