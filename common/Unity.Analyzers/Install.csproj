<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- This project only restores a package; it must also work with SDK overrides. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="*" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>
    <Target Name="InstallUnityAnalyzers">
        <Copy SourceFiles="$(PkgMicrosoft_Unity_Analyzers)/analyzers/dotnet/cs/Microsoft.Unity.Analyzers.dll"
              DestinationFolder="$(MSBuildToolsPath)/Unity.Analyzers" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)Unity.Analyzers.targets"
              DestinationFolder="$(MSBuildToolsPath)/Current/Microsoft.Common.targets/ImportAfter" />
    </Target>
</Project>
